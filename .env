# -------- Core --------
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=mbillingtool.pythonanywhere.com,localhost,127.0.0.1

# -------- CORS --------
# Keep empty unless you need browser clients from other domains.
CORS_ALLOWED_ORIGINS=

# -------- Database mode --------
# False = local database settings below (default sqlite)
# True = PythonAnywhere/MySQL cloud settings below
USE_CLOUD_DB=False

# -------- Local DB (optional) --------
# For sqlite default, leave as-is.
LOCAL_DB_ENGINE=django.db.backends.sqlite3
LOCAL_DB_NAME=db.sqlite3
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=
LOCAL_DB_PORT=

# -------- Cloud DB (PythonAnywhere) --------
CLOUD_DB_NAME=mbillingtool$vegitableshop
CLOUD_DB_USER=mbillingtool
CLOUD_DB_PASSWORD=replace-with-pythonanywhere-db-password
CLOUD_DB_HOST=mbillingtool.mysql.pythonanywhere-services.com

# -------- Firebase --------
# Keep disabled until a domain slice is migrated behind Firebase.
FIREBASE_ENABLED=True
FIREBASE_AUTO_INIT=True
USE_FIREBASE_MOBILE_SALES=True
USE_FIREBASE_CUSTOMER_LEDGER=True
USE_FIREBASE_FARMER_LEDGER=True
USE_FIREBASE_ARRIVAL=True
USE_FIREBASE_SALES=True
USE_FIREBASE_CREDIT=True
USE_FIREBASE_PATTI=True
USE_FIREBASE_EXPENDITURE=True
USE_FIREBASE_SHOP_METADATA=True
# Relative paths are resolved from vegitable/
FIREBASE_CREDENTIAL_PATH=serviceAccountKey.json
# Defaults to ../firebase.json when present. This file is frontend/web config only.
FIREBASE_WEB_CONFIG_PATH=../firebase.json
FIREBASE_PROJECT_ID=prahar-d5a02
# Optional JSON object, for example {"projectId":"your-project-id"}
FIREBASE_OPTIONS_JSON=

# -------- PythonAnywhere API scripts --------
PYTHONANYWHERE_USERNAME=mbillingtool
PYTHONANYWHERE_API_TOKEN=replace-with-pythonanywhere-api-token
PYTHONANYWHERE_WEBAPP=mbillingtool.pythonanywhere.com
PYTHONANYWHERE_PYTHON=python3.14
